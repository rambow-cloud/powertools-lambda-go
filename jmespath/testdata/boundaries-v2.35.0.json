    {
      "name": "syntax-0",
      "expression": "",
      "data": {},
      "expected": {
        "error": "IncompleteExpressionError",
        "message": "Invalid jmespath expression: parse error at column 0, found unexpected end of expression (EOF) in expression: "
      }
    },
    {
      "name": "syntax-1",
      "expression": " ",
      "data": {},
      "expected": {
        "error": "IncompleteExpressionError",
        "message": "Invalid jmespath expression: parse error at column 1, found unexpected end of expression (EOF) in expression:  "
      }
    },
    {
      "name": "syntax-2",
      "expression": "items[",
      "data": {},
      "expected": {
        "error": "IncompleteExpressionError",
        "message": "Invalid jmespath expression: parse error at column 6, found unexpected end of expression (EOF) in expression: items["
      }
    },
    {
      "name": "syntax-3",
      "expression": "foo..bar",
      "data": {},
      "expected": {
        "error": "ParseError",
        "message": "Invalid jmespath expression: parse error at column 4, found unexpected token \".\" (dot) in expression: foo..bar"
      }
    },
    {
      "name": "syntax-4",
      "expression": "'unterminated",
      "data": {},
      "expected": {
        "error": "LexerError",
        "message": "Bad jmespath expression: unknown token \"'unterminated\" at column 0 in expression: 'unterminated"
      }
    },
    {
      "name": "syntax-5",
      "expression": "@ +",
      "data": {},
      "expected": {
        "error": "LexerError",
        "message": "Bad jmespath expression: unknown token \"+\" at column 2 in expression: @ +"
      }
    },
    {
      "name": "syntax-6",
      "expression": "let $x = `1` in $x",
      "data": {},
      "expected": {
        "error": "LexerError",
        "message": "Bad jmespath expression: unknown token \"$\" at column 4 in expression: let $x = `1` in $x"
      }
    },
    {
      "name": "function-error-0",
      "expression": "unknown(@)",
      "data": 1,
      "expected": {
        "error": "UnknownFunctionError",
        "message": "Unknown function: unknown() in expression: unknown(@)"
      }
    },
    {
      "name": "function-error-1",
      "expression": "length()",
      "data": 1,
      "expected": {
        "error": "ArityError",
        "message": "Expected at least 1 argument for function length(), received 0 in expression: length()"
      }
    },
    {
      "name": "function-error-2",
      "expression": "length(@,@)",
      "data": "x",
      "expected": {
        "error": "ArityError",
        "message": "Expected at most 1 argument for function length(), received 2 in expression: length(@,@)"
      }
    },
    {
      "name": "function-error-3",
      "expression": "sum(@)",
      "data": [
        1,
        "x"
      ],
      "expected": {
        "error": "JMESPathTypeError",
        "message": "Invalid argument type for function sum(), expected \"number\" but found \"string\" in expression: sum(@)"
      }
    }
  ]
}
