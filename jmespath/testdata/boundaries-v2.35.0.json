{
  "version": "2.35.0",
  "cases": [
    {
      "name": "number-0",
      "expression": "to_number(@)",
      "data": "",
      "expected": {
        "value": 0
      }
    },
    {
      "name": "string-number-0",
      "expression": "to_string(to_number(@))",
      "data": "",
      "expected": {
        "value": "0"
      }
    },
    {
      "name": "number-1",
      "expression": "to_number(@)",
      "data": " ",
      "expected": {
        "value": 0
      }
    },
    {
      "name": "string-number-1",
      "expression": "to_string(to_number(@))",
      "data": " ",
      "expected": {
        "value": "0"
      }
    },
    {
      "name": "number-2",
      "expression": "to_number(@)",
