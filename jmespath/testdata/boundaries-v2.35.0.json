    {
      "name": "string-ascii-order",
      "expression": "to_string(@)",
      "data": {
        "b": 1,
        "a": 2
      },
      "expected": {
        "value": "{\"b\":1,\"a\":2}"
      }
    },
    {
      "name": "string-numeric-order",
      "expression": "to_string(@)",
      "data": {
        "2": "two",
        "10": "ten"
      },
      "expected": {
        "value": "{\"2\":\"two\",\"10\":\"ten\"}"
      }
