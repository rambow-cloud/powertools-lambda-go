    {
      "name": "string-line-separators",
      "expression": "to_string(@)",
      "data": {
        "value": "a b c"
      },
      "expected": {
        "value": "{\"value\":\"a b c\"}"
      }
    },
    {
      "name": "string-unicode",
      "expression": "to_string(@)",
      "data": "你好",
